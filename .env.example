# Database
DATABASE_URL="postgresql://user:password@localhost:5432/somos_venezuela?schema=public"

# NextAuth
NEXTAUTH_SECRET="your-secret-here-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Admin Initial Setup (optional - if not set, random password is generated)
# ADMIN_INITIAL_PASSWORD="your-secure-password-here"

# Prompt as Code Sync API (optional - defaults to disabled in production)
# ALLOW_SYNC_API=true  # Only enable in production for emergency sync (not recommended)

# LLM Configuration
LLM_PROVIDER="openai" # openai | anthropic | groq
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GROQ_API_KEY=""

# LLM Settings
LLM_TIMEOUT_MS="30000"
LLM_MAX_RETRIES="3"
LLM_CONCURRENCY="5"

# LLM Models per task
LLM_MODEL_SUMMARIZE="gpt-4o-mini"
LLM_MODEL_DRAFT="gpt-4o-mini"
LLM_MODEL_CLASSIFY="gpt-4o-mini"
LLM_MODEL_REVIEW="gpt-4o"
LLM_MODEL_REWRITE="gpt-4o-mini"

# LLM Temperature per task
LLM_TEMPERATURE_SUMMARIZE="0.3"
LLM_TEMPERATURE_DRAFT="0.5"
LLM_TEMPERATURE_CLASSIFY="0.2"
LLM_TEMPERATURE_REVIEW="0.1"
LLM_TEMPERATURE_REWRITE="0.4"

# Review Settings (scores are 0-100)
REVIEW_PASS_SCORE_MIN="70"  # Minimum score per category (0-100)
REVIEW_PASS_SCORE_AVG="80"  # Minimum average score (0-100)
REVIEW_FACT_EVIDENCE_REQUIRED="true"
REVIEW_MAX_AUTOFIX_ATTEMPTS="2"

# Worker Settings
WORKER_FETCH_TIMEOUT_MS="10000"
WORKER_FETCH_MAX_RETRIES="3"

# Pipeline Settings (G1: Automation & Operations)
PIPELINE_MAX_ITEMS_PER_RUN="10"           # Max items to process per pipeline run
PIPELINE_MAX_ITEMS_PER_SOURCE="5"         # Max items per source per run
PIPELINE_MAX_LLM_CALLS_PER_RUN="50"       # Max LLM API calls per run (暴走防止)
PIPELINE_STALE_PROCESSING_MINUTES="120"   # Minutes before PROCESSING is considered stale
PIPELINE_MAX_RETRY_PER_ITEM="2"           # Max retry attempts for FAILED items

# Operational Kill Switches (Launch Readiness)
PIPELINE_ENABLED="true"          # Enable/disable daily pipeline worker (false = skip execution)
FETCH_SOURCES_ENABLED="true"     # Enable/disable sources fetching worker (false = skip execution)
FETCH_DONATIONS_ENABLED="true"   # Enable/disable KGI donation fetching worker (false = skip execution)
